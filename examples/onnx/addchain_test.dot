digraph {
  graph [compound=true rankdir=LR];
  A [label=A shape=ellipse color=lime];
  B [label=B shape=ellipse color=lime];
  C [label=C shape=ellipse color=lime];
  D [label=D shape=ellipse color=lime];
  Y [label=Y shape=ellipse color=red];
  loop_lowering_Reshape [label=Reshape shape=box color=blue];
  loop_lowering_final_shape [label=4 shape=box color=maroon];
  subgraph cluster_loop_Loop_2 {
    graph [compound=true rankdir=LR];
    loopLoop_2_iter [label=iter shape=ellipse color=lime];
    loopLoop_2_cond_in [label=cond_in shape=ellipse color=lime];
    loopLoop_2_id_cond_Loop_2 [label=Identity shape=box color=blue];
    loopLoop_2_cond_out_Loop_2 [label=cond_out_Loop_2 shape=ellipse color=red];
    loopLoop_2_carry [label=carry shape=ellipse color=lime];
    loopLoop_2_Loop_2_axes [label=0 shape=box color=maroon];
    loopLoop_2_A [label=A shape=box];
    loopLoop_2_carry_ptr_in_A_1 [label=carry_ptr_in_A_1 shape=ellipse color=lime];
    loopLoop_2_ew_0_agu_step_in_A [label=1 shape=box color=maroon];
    loopLoop_2_ew_0_Add [label=Add shape=box color=blue];
    loopLoop_2_ew_0_Add -> loopLoop_2_lowering_2_id_state_out_Loop_2_1 [label=sc];
    loopLoop_2_ew_0_Unsqueeze [label=Unsqueeze shape=box color=blue];
    loopLoop_2_ew_0_Unsqueeze -> loopLoop_2_ew_0_Gather [label="{1}"];
    loopLoop_2_ew_0_Unsqueeze -> loopLoop_2_ew_0_Gather_1 [label="{1}"];
    loopLoop_2_ew_0_Unsqueeze -> loopLoop_2_ew_1_Gather [label="{1}"];
    loopLoop_2_ew_0_Unsqueeze -> loopLoop_2_ew_1_Gather_1 [label="{1}"];
    loopLoop_2_ew_0_Gather [label=Gather shape=box color=blue];
    loopLoop_2_ew_0_Gather -> loopLoop_2_ew_0_Squeeze [label="{1}"];
    loopLoop_2_ew_0_Squeeze [label=Squeeze shape=box color=blue];
    loopLoop_2_ew_0_Squeeze -> loopLoop_2_ew_0_Add_1 [label=sc];
    loopLoop_2_B [label=B shape=box];
    loopLoop_2_ew_0_Gather_1 [label=Gather shape=box color=blue];
    loopLoop_2_ew_0_Gather_1 -> loopLoop_2_ew_0_Squeeze_1 [label="{1}"];
    loopLoop_2_ew_0_Squeeze_1 [label=Squeeze shape=box color=blue];
    loopLoop_2_ew_0_Squeeze_1 -> loopLoop_2_ew_0_Add_1 [label=sc];
    loopLoop_2_ew_0_Add_1 [label=Add shape=box color=blue];
    loopLoop_2_ew_0_Add_1 -> loopLoop_2_ew_2_Add [label=sc];
    loopLoop_2_C [label=C shape=box];
    loopLoop_2_ew_1_Gather [label=Gather shape=box color=blue];
    loopLoop_2_ew_1_Gather -> loopLoop_2_ew_1_Squeeze [label="{1}"];
    loopLoop_2_ew_1_Squeeze [label=Squeeze shape=box color=blue];
    loopLoop_2_ew_1_Squeeze -> loopLoop_2_ew_1_Add [label=sc];
    loopLoop_2_D [label=D shape=box];
    loopLoop_2_ew_1_Gather_1 [label=Gather shape=box color=blue];
    loopLoop_2_ew_1_Gather_1 -> loopLoop_2_ew_1_Squeeze_1 [label="{1}"];
    loopLoop_2_ew_1_Squeeze_1 [label=Squeeze shape=box color=blue];
    loopLoop_2_ew_1_Squeeze_1 -> loopLoop_2_ew_1_Add [label=sc];
    loopLoop_2_ew_1_Add [label=Add shape=box color=blue];
    loopLoop_2_ew_1_Add -> loopLoop_2_ew_2_Add [label=sc];
    loopLoop_2_ew_2_Add [label=Add shape=box color=blue];
    loopLoop_2_ew_2_Add -> loopLoop_2_Loop_2_Reshape_1 [label=sc];
    loopLoop_2_Loop_2_one_shape [label=1 shape=box color=maroon];
    loopLoop_2_carry_out_ptr_2_2 [label=carry_out_ptr_2_2 shape=ellipse color=lime];
    loopLoop_2_Loop_2_out_step_1 [label=1 shape=box color=maroon];
    loopLoop_2_Loop_2_Add [label=Add shape=box color=blue];
    loopLoop_2_Loop_2_Add -> loopLoop_2_lowering_2_id_state_out_Loop_2_2 [label=sc];
    loopLoop_2_Loop_2_Reshape [label=Reshape shape=box color=blue];
    loopLoop_2_Loop_2_Reshape -> loopLoop_2_Loop_2_ScatterElements [label="{1}"];
    loopLoop_2_Loop_2_Reshape_1 [label=Reshape shape=box color=blue];
    loopLoop_2_Loop_2_Reshape_1 -> loopLoop_2_Loop_2_ScatterElements [label="{1}"];
    loopLoop_2_Loop_2_ScatterElements [label=ScatterElements shape=box color=blue];
    loopLoop_2_Loop_2_ScatterElements -> loopLoop_2_lowering_2_id_state_out_Loop_2_0 [label="{4}"];
    loopLoop_2_lowering_2_0_state_out_Loop_2 [label=lowering_2_0_state_out_Loop_2 shape=ellipse color=red];
    loopLoop_2_lowering_2_id_state_out_Loop_2_0 [label=Identity shape=box color=blue];
    loopLoop_2_lowering_2_1_state_out_Loop_2 [label=lowering_2_1_state_out_Loop_2 shape=ellipse color=red];
    loopLoop_2_lowering_2_id_state_out_Loop_2_1 [label=Identity shape=box color=blue];
    loopLoop_2_lowering_2_2_state_out_Loop_2 [label=lowering_2_2_state_out_Loop_2 shape=ellipse color=red];
    loopLoop_2_lowering_2_id_state_out_Loop_2_2 [label=Identity shape=box color=blue];
    loopLoop_2_cond_in -> loopLoop_2_id_cond_Loop_2 [label=sc];
    loopLoop_2_lowering_2_id_state_out_Loop_2_1 -> loopLoop_2_lowering_2_1_state_out_Loop_2 [label=sc];
    loopLoop_2_carry_ptr_in_A_1 -> loopLoop_2_ew_0_Add [label=sc];
    loopLoop_2_ew_0_agu_step_in_A -> loopLoop_2_ew_0_Add [label=sc];
    loopLoop_2_id_cond_Loop_2 -> loopLoop_2_cond_out_Loop_2 [label=sc];
    loopLoop_2_carry_ptr_in_A_1 -> loopLoop_2_ew_0_Unsqueeze [label=sc];
    loopLoop_2_Loop_2_axes -> loopLoop_2_ew_0_Unsqueeze [label="{1}"];
    loopLoop_2_A -> loopLoop_2_ew_0_Gather [label="{4}"];
    loopLoop_2_Loop_2_axes -> loopLoop_2_ew_0_Squeeze [label="{1}"];
    loopLoop_2_B -> loopLoop_2_ew_0_Gather_1 [label="{4}"];
    loopLoop_2_Loop_2_axes -> loopLoop_2_ew_0_Squeeze_1 [label="{1}"];
    loopLoop_2_C -> loopLoop_2_ew_1_Gather [label="{4}"];
    loopLoop_2_Loop_2_axes -> loopLoop_2_ew_1_Squeeze [label="{1}"];
    loopLoop_2_D -> loopLoop_2_ew_1_Gather_1 [label="{4}"];
    loopLoop_2_Loop_2_axes -> loopLoop_2_ew_1_Squeeze_1 [label="{1}"];
    loopLoop_2_carry_out_ptr_2_2 -> loopLoop_2_Loop_2_Add [label=sc];
    loopLoop_2_Loop_2_out_step_1 -> loopLoop_2_Loop_2_Add [label=sc];
    loopLoop_2_carry_out_ptr_2_2 -> loopLoop_2_Loop_2_Reshape [label=sc];
    loopLoop_2_Loop_2_one_shape -> loopLoop_2_Loop_2_Reshape [label="{1}"];
    loopLoop_2_Loop_2_one_shape -> loopLoop_2_Loop_2_Reshape_1 [label="{1}"];
    loopLoop_2_carry -> loopLoop_2_Loop_2_ScatterElements [label="{4}"];
    loopLoop_2_lowering_2_id_state_out_Loop_2_0 -> loopLoop_2_lowering_2_0_state_out_Loop_2 [label="{4}"];
    loopLoop_2_lowering_2_id_state_out_Loop_2_2 -> loopLoop_2_lowering_2_2_state_out_Loop_2 [label=sc];
    graph [label="Loop Loop_2"];
    graph [style=dashed];
    graph [color=gray];
  }

  loop_lowering_trip_count_Loop_2 [label=4 shape=box color=maroon];
  loop_lowering_cond_Loop_2 [label=1 shape=box color=maroon];
  loop_lowering_init_carry_Loop_2 [label="0,0,0,0" shape=box color=maroon];
  loopLoop_2_Loop_2 -> loop_lowering_Reshape [label="{4}" ltail=cluster_loop_Loop_2];
  loop_lowering_init_ptr_in_A [label=0 shape=box color=maroon];
  loop_lowering_init_out_ptr_2 [label=0 shape=box color=maroon];
  loop_lowering_final_shape -> loop_lowering_Reshape [label="{1}"];
  loop_lowering_trip_count_Loop_2 -> loopLoop_2_Loop_2 [label=sc lhead=cluster_loop_Loop_2];
  loop_lowering_cond_Loop_2 -> loopLoop_2_Loop_2 [label=sc lhead=cluster_loop_Loop_2];
  loop_lowering_init_out_ptr_2 -> loopLoop_2_Loop_2 [label=sc lhead=cluster_loop_Loop_2];
  loop_lowering_init_ptr_in_A -> loopLoop_2_Loop_2 [label=sc lhead=cluster_loop_Loop_2];
  loop_lowering_init_carry_Loop_2 -> loopLoop_2_Loop_2 [label="{4}" lhead=cluster_loop_Loop_2];
  loop_lowering_Reshape -> Y [label="{4}"];
}
