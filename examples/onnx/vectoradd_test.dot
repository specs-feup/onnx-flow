digraph {
  graph [compound=true rankdir=LR];
  A [label=A shape=ellipse color=lime];
  B [label=B shape=ellipse color=lime];
  C [label=C shape=ellipse color=red];
  lowering_0_Reshape [label=Reshape shape=box color=blue];
  lowering_0_trip_count_Loop_0 [label=4 shape=box color=maroon];
  lowering_0_cond_Loop_0 [label=1 shape=box color=maroon];
  lowering_0_init_carry_Loop_0 [label="0,0,0,0" shape=box color=maroon];
  subgraph cluster_loop_Loop_0 {
    graph [compound=true rankdir=LR];
    loopLoop_0_iter [label=iter shape=ellipse color=lime];
    loopLoop_0_cond_in [label=cond_in shape=ellipse color=lime];
    loopLoop_0_carry [label=carry shape=ellipse color=lime];
    loopLoop_0_id_cond_Loop_0 [label=Identity shape=box color=blue];
    loopLoop_0_cond_out_Loop_0 [label=cond_out_Loop_0 shape=ellipse color=red];
    loopLoop_0_Loop_0_axes [label=0 shape=box color=maroon];
    loopLoop_0_A [label=A shape=box];
    loopLoop_0_ew_0_mr_dim_gb_out_A_0 [label=4 shape=box color=maroon];
    loopLoop_0_ew_0_Mod [label=Mod shape=box color=blue];
    loopLoop_0_ew_0_Mod -> loopLoop_0_ew_0_Mul [label=sc];
    loopLoop_0_ew_0_Div [label=Div shape=box color=blue];
    loopLoop_0_ew_0_lin_zero_gb_lin_A [label=0 shape=box color=maroon];
    loopLoop_0_ew_0_lin_stride_gb_lin_A_0 [label=1 shape=box color=maroon];
    loopLoop_0_ew_0_Mul [label=Mul shape=box color=blue];
    loopLoop_0_ew_0_Mul -> loopLoop_0_ew_0_Add [label=sc];
    loopLoop_0_ew_0_Add [label=Add shape=box color=blue];
    loopLoop_0_ew_0_Add -> loopLoop_0_ew_0_Unsqueeze [label=sc];
    loopLoop_0_ew_0_Unsqueeze [label=Unsqueeze shape=box color=blue];
    loopLoop_0_ew_0_Unsqueeze -> loopLoop_0_ew_0_Gather [label="{1}"];
    loopLoop_0_ew_0_Unsqueeze -> loopLoop_0_ew_0_Gather_1 [label="{1}"];
    loopLoop_0_ew_0_Gather [label=Gather shape=box color=blue];
    loopLoop_0_ew_0_Gather -> loopLoop_0_ew_0_Squeeze [label="{1}"];
    loopLoop_0_ew_0_Squeeze [label=Squeeze shape=box color=blue];
    loopLoop_0_ew_0_Squeeze -> loopLoop_0_ew_0_Add_1 [label=sc];
    loopLoop_0_B [label=B shape=box];
    loopLoop_0_ew_0_Gather_1 [label=Gather shape=box color=blue];
    loopLoop_0_ew_0_Gather_1 -> loopLoop_0_ew_0_Squeeze_1 [label="{1}"];
    loopLoop_0_ew_0_Squeeze_1 [label=Squeeze shape=box color=blue];
    loopLoop_0_ew_0_Squeeze_1 -> loopLoop_0_ew_0_Add_1 [label=sc];
    loopLoop_0_ew_0_Add_1 [label=Add shape=box color=blue];
    loopLoop_0_ew_0_Add_1 -> loopLoop_0_Loop_0_Reshape_1 [label=sc];
    loopLoop_0_Loop_0_one_shape [label=1 shape=box color=maroon];
    loopLoop_0_Loop_0_Reshape [label=Reshape shape=box color=blue];
    loopLoop_0_Loop_0_Reshape -> loopLoop_0_Loop_0_ScatterElements [label="{1}"];
    loopLoop_0_Loop_0_Reshape_1 [label=Reshape shape=box color=blue];
    loopLoop_0_Loop_0_Reshape_1 -> loopLoop_0_Loop_0_ScatterElements [label="{1}"];
    loopLoop_0_Loop_0_ScatterElements [label=ScatterElements shape=box color=blue];
    loopLoop_0_Loop_0_ScatterElements -> loopLoop_0_lowering_0_id_state_out_Loop_0_0 [label="{4}"];
    loopLoop_0_lowering_0_0_state_out_Loop_0 [label=lowering_0_0_state_out_Loop_0 shape=ellipse color=red];
    loopLoop_0_lowering_0_id_state_out_Loop_0_0 [label=Identity shape=box color=blue];
    loopLoop_0_cond_in -> loopLoop_0_id_cond_Loop_0 [label=sc];
    loopLoop_0_iter -> loopLoop_0_ew_0_Mod [label=sc];
    loopLoop_0_ew_0_mr_dim_gb_out_A_0 -> loopLoop_0_ew_0_Mod [label=sc];
    loopLoop_0_id_cond_Loop_0 -> loopLoop_0_cond_out_Loop_0 [label=sc];
    loopLoop_0_iter -> loopLoop_0_ew_0_Div [label=sc];
    loopLoop_0_ew_0_mr_dim_gb_out_A_0 -> loopLoop_0_ew_0_Div [label=sc];
    loopLoop_0_ew_0_lin_stride_gb_lin_A_0 -> loopLoop_0_ew_0_Mul [label=sc];
    loopLoop_0_ew_0_lin_zero_gb_lin_A -> loopLoop_0_ew_0_Add [label=sc];
    loopLoop_0_Loop_0_axes -> loopLoop_0_ew_0_Unsqueeze [label="{1}"];
    loopLoop_0_A -> loopLoop_0_ew_0_Gather [label="{4}"];
    loopLoop_0_Loop_0_axes -> loopLoop_0_ew_0_Squeeze [label="{1}"];
    loopLoop_0_B -> loopLoop_0_ew_0_Gather_1 [label="{4}"];
    loopLoop_0_Loop_0_axes -> loopLoop_0_ew_0_Squeeze_1 [label="{1}"];
    loopLoop_0_iter -> loopLoop_0_Loop_0_Reshape [label=sc];
    loopLoop_0_Loop_0_one_shape -> loopLoop_0_Loop_0_Reshape [label="{1}"];
    loopLoop_0_Loop_0_one_shape -> loopLoop_0_Loop_0_Reshape_1 [label="{1}"];
    loopLoop_0_carry -> loopLoop_0_Loop_0_ScatterElements [label="{4}"];
    loopLoop_0_lowering_0_id_state_out_Loop_0_0 -> loopLoop_0_lowering_0_0_state_out_Loop_0 [label="{4}"];
    graph [label="Loop Loop_0"];
    graph [style=dashed];
    graph [color=gray];
  }

  loopLoop_0_Loop_0 -> lowering_0_Reshape [label="{4}" ltail=cluster_loop_Loop_0];
  lowering_0_final_shape [label=4 shape=box color=maroon];
  lowering_0_final_shape -> lowering_0_Reshape [label="{1}"];
  lowering_0_trip_count_Loop_0 -> loopLoop_0_Loop_0 [label=sc lhead=cluster_loop_Loop_0];
  lowering_0_cond_Loop_0 -> loopLoop_0_Loop_0 [label=sc lhead=cluster_loop_Loop_0];
  lowering_0_init_carry_Loop_0 -> loopLoop_0_Loop_0 [label="{4}" lhead=cluster_loop_Loop_0];
  lowering_0_Reshape -> C [label="{4}"];
}
