{
    "name": "@specs-feup/onnx-flow",
    "version": "1.0.7",
    "engines": {
        "node": ">=16"
    },
    "publishConfig": {
        "access": "public"
    },
    "description": "Tool to convert an ONNX graph into a data-flow graph (DFG), decomposing its high-level operations into low-level operations and performing a set of optimizations.",
    "bin": {
        "onnx-flow": "./out/src/index.js"
    },
    "keywords": [
        "onnx",
        "optimization",
        "operation decomposition",
        "dfg"
    ],
    "main": "./out/src/index.js",
    "files": [
        "out/",
        "src/onnx/onnx.proto",
        "package.json",
        "README.md"
    ],
    "scripts": {
        "clean": "rimraf out",
        "build": "tsc",
        "build:watch": "tsc --watch",
        "postbuild": "npx cpx2 \"src/onnx/onnx.proto\" \"out/src/onnx\"",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write \"{src,test}/**/*.{ts,js,json}\" package.json",
        "lint": "eslint \"{src,test}/**/*.{ts,js}\" --fix",
        "lint:check": "eslint \"{src,test}/**/*.{ts,js}\"",
        "test": "vitest run",
        "test:unit": "vitest run test/unit",
        "pretest:integration": "npm run build",
        "test:integration": "vitest run test/integration",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "vitest run --config vitest.e2e.config.ts",
        "test:all": "npm run test:unit && npm run test:integration",
        "test:unit:coverage": "vitest run test/unit --coverage",
        "test:integration:coverage": "vitest run test/integration --coverage",
        "test:ci": "vitest run --coverage",
        "testcomp": "vitest run test/integration/compatibility.test.ts",
        "testpartition": "vitest run test/integration/partitioning.test.ts",
        "testops": "vitest run test/integration/op-equivalence.test.ts",
        "testopts": "vitest run test/integration/compiler-options.test.ts",
        "prepare": "npm run build && husky install",
        "prepublishOnly": "npm run clean && npm run build && npm run typecheck"
    },
    "author": "José Pedro Ferreira, Bruno Oliveira, Nelson Neto, António Abílio",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/specs-feup/onnx-flow.git"
    },
    "homepage": "https://github.com/specs-feup/onnx-flow#readme",
    "license": "Apache-2.0",
    "dependencies": {
        "@specs-feup/flow": "^1.0.3",
        "express": "^4.21.1",
        "long": "^5.2.3",
        "node-graphviz": "^0.1.1",
        "protobufjs": "^7.4.0",
        "yargs": "^17.7.2"
    },
    "type": "module",
    "devDependencies": {
        "@types/express": "^5.0.0",
        "@types/yargs": "^17.0.33",
        "@typescript-eslint/eslint-plugin": "^8.54.0",
        "@typescript-eslint/parser": "^8.54.0",
        "@vitest/coverage-v8": "^5.0.3",
        "cpx2": "^8.0.0",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "globals": "^17.3.0",
        "husky": "^8.0.0",
        "nodemon": "^3.1.7",
        "npm-run-all": "^4.1.5",
        "onnxruntime-web": "^1.31.1",
        "prettier": "^3.8.1",
        "rimraf": "^6.0.1",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.54.0",
        "vitest": "^5.0.3"
    },
    "lint-staged": {
        "{src,test}/**/*.{ts,js}": [
            "prettier --write",
            "eslint --fix"
        ],
        "{src,test}/**/*.json": [
            "prettier --write"
        ],
        "package.json": [
            "prettier --write"
        ]
    },
    "parserOptions": {
        "project": [
            "./tsconfig.*.json"
        ]
    },
    "exports": {
        ".": {
            "types": "./out/src/api.d.ts",
            "default": "./out/src/api.js"
        },
        "./recipes": {
            "types": "./out/src/recipes.d.ts",
            "default": "./out/src/recipes.js"
        },
        "./*": {
            "types": "./out/src/*.d.ts",
            "default": "./out/src/*.js"
        }
    },
    "allowScripts": {
        "protobufjs": true,
        "esbuild@0.28.2": true
    }
}
