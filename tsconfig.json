{
    "compilerOptions": {
        // Modern Node.js Execution
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "outDir": "out/",

        // Declarations & Maps
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,

        // Interoperability
        "allowJs": false,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,

        // The "Maximum Strictness" Suite
        "strict": true,
        "strictFunctionTypes": false,
        "noImplicitOverride": true,
        "exactOptionalPropertyTypes": true,
        "noFallthroughCasesInSwitch": true,
        "noPropertyAccessFromIndexSignature": true, // Forces `obj['key']` instead of `obj.key` for unknown dictionaries
        
        // Performance
        "skipLibCheck": true,

        // Path Aliases
        "paths": {
            "@specs-feup/onnx-flow/*": ["./src/*.ts", "./test/*.ts"]
        }
    },
    "exclude": ["node_modules", "out", "graph-visualizer"]
}